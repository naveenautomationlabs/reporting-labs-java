<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.reportinglabs</groupId>
  <artifactId>reporting-labs-parent</artifactId>
  <version>0.1.23</version>
  <packaging>pom</packaging>

  <name>reportingLabs (parent)</name>
  <description>Parent POM for reportingLabs Java integrations (core, JUnit 5, TestNG, Playwright, Selenium, REST Assured).</description>
  <url>https://reportinglabs.dev</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>naveenautomationlabs</id>
      <name>Naveen AutomationLabs</name>
      <email>naveenanimation20@gmail.com</email>
      <url>https://github.com/naveenautomationlabs</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/naveenautomationlabs/reporting-labs-java</url>
    <connection>scm:git:https://github.com/naveenautomationlabs/reporting-labs-java.git</connection>
    <developerConnection>scm:git:git@github.com:naveenautomationlabs/reporting-labs-java.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/naveenautomationlabs/reporting-labs-java/issues</url>
  </issueManagement>

  <!-- Only the four published library modules live in the top-level
       reactor. The examples subtree is opt-in via the 'with-examples'
       profile (default-on for `mvn test`, auto-off whenever any explicit
       profile is passed, e.g. -Prelease). This keeps the examples out of
       Central bundles entirely — they never even see the deploy phase. -->
  <modules>
    <module>core</module>
    <module>junit5</module>
    <module>testng</module>
    <module>playwright</module>
    <module>selenium</module>
    <module>rest-assured</module>
    <module>cucumber</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>

    <junit.jupiter.version>5.10.2</junit.jupiter.version>
    <junit.platform.version>1.10.2</junit.platform.version>
    <testng.version>7.10.2</testng.version>
    <playwright.version>1.47.0</playwright.version>
    <selenium.version>4.20.0</selenium.version>
    <rest-assured.version>5.3.0</rest-assured.version>
    <cucumber.version>7.15.0</cucumber.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.reportinglabs</groupId>
        <artifactId>reporting-labs-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.jupiter.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter-api</artifactId>
        <version>${junit.jupiter.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.platform</groupId>
        <artifactId>junit-platform-launcher</artifactId>
        <version>${junit.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testng</groupId>
        <artifactId>testng</artifactId>
        <version>${testng.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microsoft.playwright</groupId>
        <artifactId>playwright</artifactId>
        <version>${playwright.version}</version>
      </dependency>
      <dependency>
        <groupId>org.seleniumhq.selenium</groupId>
        <artifactId>selenium-java</artifactId>
        <version>${selenium.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured</artifactId>
        <version>${rest-assured.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-plugin</artifactId>
        <version>${cucumber.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals><goal>jar-no-fork</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.7.0</version>
          <configuration>
            <doclint>none</doclint>
            <quiet>true</quiet>
          </configuration>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <goals><goal>jar</goal></goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.4</version>
          <executions>
            <execution>
              <id>sign-artifacts</id>
              <phase>verify</phase>
              <goals><goal>sign</goal></goals>
              <configuration>
                <bestPractices>true</bestPractices>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Default-on profile that pulls in the examples subtree. Turns
         itself off automatically the moment any explicit profile is
         passed on the command line (Maven quirk of activeByDefault),
         which is exactly what we want for `mvn -Prelease deploy`. -->
    <profile>
      <id>with-examples</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>examples</module>
      </modules>
    </profile>

    <!-- Activate with `-P release` when publishing to Maven Central. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <!-- 0.7.0 uploads correctly but chokes on the 'warnings' field
                 Central now returns from the deployment-status endpoint —
                 fixed in 0.8.0. -->
            <version>0.8.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <!-- Wait until the bundle has actually landed, not until
                   Central finishes validating it. Validation can be watched
                   on the portal (https://central.sonatype.com/publishing/deployments).
                   This also side-steps the 0.7.x poll-response parse bug. -->
              <waitUntil>uploaded</waitUntil>
              <!-- Central counts every uploaded file against the monthly
                   publishing limit. MD5 and SHA-1 are the only checksums it
                   requires; SHA-256 and SHA-512 are optional and double the
                   file count, so they are not generated. -->
              <checksums>required</checksums>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
